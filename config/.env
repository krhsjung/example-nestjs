# 프로세스가 서버의 로컬 타임존(예: Asia/Seoul)으로 동작하여 datatime을 저장할 때 의도차 않은 오프셋 발생.
# Process Timezone을 서버 로컬 timezone이 아닌 UTC로 설정하여 이슈 해셜.
TZ=UTC
EXCAMPLE_API_PORT=3000

# PostgreSQL connection information
POSTGRES_USER=${EXAMPLE_NESTJS_POSTGRES_USER}
POSTGRES_PASSWORD=${EXAMPLE_NESTJS_POSTGRES_PASSWORD}
POSTGRES_DATABASE_NAME=${EXAMPLE_NESTJS_POSTGRES_DATABASE_NAME}

POSTGRES_PRIMARY_HOST=${EXAMPLE_NESTJS_POSTGRES_PRIMARY_HOST}
POSTGRES_PRIMARY_PORT=${EXAMPLE_NESTJS_POSTGRES_PRIMARY_PORT}

POSTGRES_STANDBY_HOST=${EXAMPLE_NESTJS_POSTGRES_STANDBY_HOST}
POSTGRES_STANDBY_PORT=${EXAMPLE_NESTJS_POSTGRES_STANDBY_PORT}

# JWT configuration
JWT_ACCESS_TOKEN_EXPIRES_IN=${EXAMPLE_JWT_ACCESS_TOKEN_EXPIRES_IN}
JWT_REFRESH_TOKEN_EXPIRES_IN=${EXAMPLE_JWT_REFRESH_TOKEN_EXPIRES_IN}
JWT_SECRET_KEY=${EXAMPLE_JWT_SECRET_KEY}
JWT_REFRESH_SECRET_KEY=${EXAMPLE_JWT_REFRESH_SECRET_KEY}