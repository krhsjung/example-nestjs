# Common settings for all environments
# 프로세스가 서버의 로컬 타임존(예: Asia/Seoul)으로 동작하여 datatime을 저장할 때 의도차 않은 오프셋 발생.
# Process Timezone을 서버 로컬 timezone이 아닌 UTC로 설정하여 이슈 해셜.
TZ=UTC
EXAMPLE_API_PORT=3000

# Service Domain
SERVICE_DOMAIN=${EXAMPLE_SERVICE_DOMAIN}


# PostgreSQL connection information
POSTGRES_PRIMARY_HOST=localhost
POSTGRES_PRIMARY_PORT=${POSTGRES_PRIMARY_PORT}
POSTGRES_PRIMARY_USER=${EXAMPLE_NESTJS_POSTGRES_USER}
POSTGRES_PRIMARY_PASSWORD=${EXAMPLE_NESTJS_POSTGRES_PASSWORD}

POSTGRES_STANDBY_HOST=localhost
POSTGRES_STANDBY_PORT=${POSTGRES_STANDBY_PORT}
POSTGRES_STANDBY_USER=${EXAMPLE_NESTJS_POSTGRES_USER}
POSTGRES_STANDBY_PASSWORD=${EXAMPLE_NESTJS_POSTGRES_PASSWORD}

POSTGRES_DATABASE_NAME=${EXAMPLE_POSTGRES_DATABASE_NAME}


# Redis connection information
REDIS_MODE=${REDIS_MODE}
REDIS_HOST=localhost
REDIS_PORT=${REDIS_PORT}
REDIS_USERNAME=${REDIS_USERNAME}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB_INDEX=${REDIS_DB_INDEX}


# JWT configuration
JWT_ACCESS_TOKEN_EXPIRES_IN=${EXAMPLE_JWT_ACCESS_TOKEN_EXPIRES_IN}
JWT_REFRESH_TOKEN_EXPIRES_IN=${EXAMPLE_JWT_REFRESH_TOKEN_EXPIRES_IN}
JWT_SECRET_KEY=${EXAMPLE_JWT_SECRET_KEY}
JWT_REFRESH_SECRET_KEY=${EXAMPLE_JWT_REFRESH_SECRET_KEY}


# OAuth (optional for local)
EXAMPLE_GOOGLE_CLIENT_ID=${EXAMPLE_GOOGLE_CLIENT_ID}
EXAMPLE_GOOGLE_CLIENT_SECRET=${EXAMPLE_GOOGLE_CLIENT_SECRET}

EXAMPLE_APPLE_TEAM_ID=${EXAMPLE_APPLE_TEAM_ID}
EXAMPLE_APPLE_CLIENT_ID=${EXAMPLE_APPLE_CLIENT_ID}
EXAMPLE_APPLE_KEY_ID=${EXAMPLE_APPLE_KEY_ID}
EXAMPLE_APPLE_PRIVATE_KEY=${EXAMPLE_APPLE_PRIVATE_KEY}